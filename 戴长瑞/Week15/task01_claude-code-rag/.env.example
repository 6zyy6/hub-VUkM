# 环境配置
DEBUG=false

# 服务器
HOST=0.0.0.0
PORT=8000

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_TEXT=mmrag_text
MILVUS_COLLECTION_IMAGE=mmrag_image

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PDF=pdf-processing
KAFKA_TOPIC_IMAGE=image-processing
KAFKA_CONSUMER_GROUP=mmrag-workers

# 模型配置
PDF_PARSER=mineru
MINERU_MODEL_PATH=

# CLIP
CLIP_MODEL=openai/clip-vit-base-patch32

# BGE
BGE_MODEL=BAAI/bge-m3

# Qwen-VL
QWEN_MODEL=Qwen/Qwen2-VL-7B-Instruct
QWEN_DEVICE=cuda

# 存储
UPLOAD_DIR=./data/uploads
PARSED_DIR=./data/parsed
IMAGE_DIR=./data/images