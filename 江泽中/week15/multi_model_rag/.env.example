# 模型路径配置
BGE_MODEL_PATH=./models/bge-small-zh-v1.5
CLIP_MODEL_PATH=./models/jina-clip-v2

# Milvus配置
MILVUS_URI=https://in03-5cb3b56f3af9ebc.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
MILVUS_TOKEN=your_milvus_token_here

# Qwen API配置
QWEN_API_KEY=sk-your_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Kafka配置
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=rag-data

# MinerU配置
MINERU_BASE_URL=http://127.0.0.1:30000
MINERU_BACKEND=vlm-http-client
MINERU_TIMEOUT=600

# 处理参数
CHUNK_SIZE=256
SEARCH_LIMIT=5
BATCH_INSERT_SIZE=50
